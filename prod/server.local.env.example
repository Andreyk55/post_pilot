# ────────────────────────────────────────────────────────────────────────────
# PostPilot — production env, LOCAL Postgres + SUPABASE Storage mode.
#
# Use this when you want the app to run against the in-compose
# postpilot-postgres container (no Supabase Postgres) but keep media on
# Supabase Storage. MinIO is no longer supported in production.
#
# Setup:
#   cp prod/server.local.env.example /opt/postpilot/server.env
#   nano /opt/postpilot/server.env            # replace every CHANGE_ME
#   chmod 600 /opt/postpilot/server.env
#
# Start the stack WITH the localdb profile so the postgres container runs:
#   docker compose -f prod/docker-compose.yml --profile localdb up -d
#
# NEVER commit the real /opt/postpilot/server.env.
# NEVER expose MediaStorage__Supabase__ServiceRoleKey to the frontend.
# ────────────────────────────────────────────────────────────────────────────

# ── ASP.NET Core runtime ───────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5122

# ── App run mode ───────────────────────────────────────────────────────────
App__RunMode=Server
APP_RUN_MODE=Server
App__EnableHttpsRedirect=false

# ── Public URLs ────────────────────────────────────────────────────────────
Frontend__BaseUrl=https://www.publishharbor.com
Backend__BaseUrl=https://api.publishharbor.com
App__PublicUrl=https://api.publishharbor.com

# ── CORS ───────────────────────────────────────────────────────────────────
Cors__AllowedOrigins__0=https://www.publishharbor.com

# ── Private access gate ────────────────────────────────────────────────────
# PasswordHash is a BCrypt hash — generate via scripts/gen-private-access-hash.ps1.
PrivateAccess__Enabled=true
PrivateAccess__PasswordHash=CHANGE_ME_BCRYPT_HASH
PrivateAccess__CookieName=postpilot_private_access
PrivateAccess__SessionDays=7
PrivateAccess__CookieSigningKey=CHANGE_ME_RANDOM_32_CHARS

# ── Database: local Docker Postgres (postpilot-postgres compose service) ───
# These three POSTGRES_* vars are consumed by the postgres image to init the
# database; the ConnectionStrings__ line is what the .NET app uses. Keep all
# four passwords identical.
POSTGRES_DB=postpilot
POSTGRES_USER=postpilot
POSTGRES_PASSWORD=CHANGE_ME
ConnectionStrings__DefaultConnection=Host=postpilot-postgres;Port=5432;Database=postpilot;Username=postpilot;Password=CHANGE_ME

# ── Meta / Facebook ────────────────────────────────────────────────────────
Meta__AppId=CHANGE_ME
Meta__AppSecret=CHANGE_ME
Meta__RedirectUri=https://www.publishharbor.com/oauth/meta/callback
META_APP_ID=CHANGE_ME
META_APP_SECRET=CHANGE_ME
# Meta diagnostic endpoints (e.g. GET /api/meta/instagram/debug). Keep FALSE in production;
# when false these endpoints return 404 outside Development. Only enable briefly to troubleshoot.
Meta__EnableDebugEndpoints=false

# ── Gemini AI ──────────────────────────────────────────────────────────────
Gemini__ApiKey=CHANGE_ME
Gemini__Model=gemini-2.0-flash
Gemini__VisionModel=gemini-2.0-flash
GEMINI_API_KEY=CHANGE_ME

# ── AI rate limiter ────────────────────────────────────────────────────────
# Default per-user quota and window. Users listed in OverrideUserIds get
# OverrideMaxCallsPerDay instead (comma-separated internal PostPilot user IDs,
# whitespace trimmed, case-insensitive). If OverrideMaxCallsPerDay is missing or
# <= 0, listed users fall back to MaxCallsPerDay.
Ai__RateLimiter__MaxCallsPerDay=20
Ai__RateLimiter__WindowHours=24
Ai__RateLimiter__OverrideMaxCallsPerDay=30
Ai__RateLimiter__OverrideUserIds=00000000-0000-0000-0000-000000000000,11111111-1111-1111-1111-111111111111

# ── Media storage (Supabase Storage) ───────────────────────────────────────
# Even with local Postgres we use Supabase Storage in prod — MinIO has been
# retired (see prod/docker-compose.yml). The bucket MUST be private.
MediaStorage__Provider=Supabase
MediaStorage__Supabase__Url=https://YOUR_PROJECT.supabase.co
MediaStorage__Supabase__ServiceRoleKey=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
MediaStorage__Supabase__Bucket=postpilot-media
MediaStorage__Supabase__SignedUrlExpirySeconds=3600
MediaStorage__Supabase__MaxUploadBytes=104857600
